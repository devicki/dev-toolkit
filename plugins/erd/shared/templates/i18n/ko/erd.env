# erd 플러그인 설정 (scripts/erd-doc.sh 가 읽음)
# 이 파일이 있는 폴더 = ERD 단위 (DB 하나). 아래 상대 경로는 모두 이 폴더 기준.

# 문서·주석·에이전트 지침 언어: ko | en (식별자는 언어와 무관하게 영문)
ERD_LANG=ko

# DB 종류: postgres | mysql
ERD_DIALECT=postgres

# 스키마 원본
#   dbml       : db/*.dbml 이 원본 (초기 구축, 마이그레이션 도구 없음)
#   migrations : ORM/마이그레이션 도구가 원본. 아래 ERD_MIGRATE_CMD 로 임시 DB에 적용 후 문서화
ERD_SOURCE=dbml

# ERD_SOURCE=dbml 일 때
ERD_DBML_ENTRY=db/schema.dbml
ERD_SQL_OUT=db/schema.sql

# ERD_SOURCE=migrations 일 때: 임시 DB에 스키마를 만드는 명령
# DATABASE_URL 환경변수로 임시 DB 주소가 전달됨. 공백이 있으면 작은따옴표로 감싼다. 예:
#   ERD_MIGRATE_CMD='alembic upgrade head'
#   ERD_MIGRATE_CMD='npx prisma migrate deploy'
#   ERD_MIGRATE_CMD='python manage.py migrate --noinput'
ERD_MIGRATE_CMD=
ERD_DERIVED_DBML=db/schema.generated.dbml

# 이 DB를 사용하는 다른 폴더 (모노레포의 프론트·다른 앱 등). 레포 루트 기준, 쉼표 구분
# /erd:import, /erd:review, /erd:design 이 함께 참고한다. 예: ERD_RELATED_SOURCES='apps/web,apps/admin'
ERD_RELATED_SOURCES=

# Docker 이미지 (비우면 postgres:16 / mysql:8). 운영 DB 버전에 맞추기를 권장
ERD_DOCKER_IMAGE=

# make erd-check 에서 lint 경고도 실패로 볼지: warn(기본) | strict
ERD_CHECK_LINT=warn
