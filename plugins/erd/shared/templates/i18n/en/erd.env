# erd plugin settings (read by scripts/erd-doc.sh)
# The folder containing this file = one ERD unit (one DB). All relative paths below are relative to this folder.

# Language for docs, comments and agent instructions: ko | en (identifiers are always English)
ERD_LANG=en

# Database: postgres | mysql
ERD_DIALECT=postgres

# Source of truth
#   dbml       : db/*.dbml is the source (greenfield, no migration tool)
#   migrations : the ORM/migration tool is the source. ERD_MIGRATE_CMD below builds a temporary DB, which is then documented
ERD_SOURCE=dbml

# When ERD_SOURCE=dbml
ERD_DBML_ENTRY=db/schema.dbml
ERD_SQL_OUT=db/schema.sql

# When ERD_SOURCE=migrations: command that creates the schema in the temporary DB
# The temporary DB URL is passed in DATABASE_URL. Wrap values containing spaces in single quotes. e.g.:
#   ERD_MIGRATE_CMD='alembic upgrade head'
#   ERD_MIGRATE_CMD='npx prisma migrate deploy'
#   ERD_MIGRATE_CMD='python manage.py migrate --noinput'
ERD_MIGRATE_CMD=
ERD_DERIVED_DBML=db/schema.generated.dbml

# Other folders that use this DB (frontends, other apps in a monorepo). Relative to repo root, comma-separated
# Read by /erd:import, /erd:review, /erd:design. e.g. ERD_RELATED_SOURCES='apps/web,apps/admin'
ERD_RELATED_SOURCES=

# Docker image (empty = postgres:16 / mysql:8). Matching the production DB version is recommended
ERD_DOCKER_IMAGE=

# Whether make erd-check treats lint warnings as failures: warn (default) | strict
ERD_CHECK_LINT=warn
